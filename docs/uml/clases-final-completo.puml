@startuml clases-final-completo
scale max 3800*3800
skinparam defaultFontName Arial
skinparam defaultFontSize 14
title SIGMA - Diagrama de clases final (Etapa 1)
top to bottom direction
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam nodesep 25
skinparam ranksep 35
hide empty members

package "Barrio y vecinos" {
  class Barrio {
    - nombre: String
    - lotes: List<Lote>
    - personal: List<Empleado>
    - equipos: List<Equipo>
    + calcularSuperficieTotal(): double
    + obtenerLote(numero: int): Lote
  }
  class Persona {
    - nombre: String
    - apellido: String
    - documento: String
    - telefono: String
    - correoElectronico: String
    + Persona(nombre: String, apellido: String, documento: String, telefono: String, correo: String)
    + getDocumento(): String
    + actualizarContacto(telefono: String, correo: String): void
  }
  class Lote {
    - numero: int
    - superficie: double
    - moroso: boolean
    + Lote(numero: int, superficie: double)
    + calcularCoeficiente(superficieTotal: double): double
    + estaAutorizada(persona: Persona, fecha: LocalDate): boolean
    + calcularDeuda(fecha: LocalDate, mora: CalculadoraMora): BigDecimal
    + actualizarMorosidad(expensas: List<Expensa>, fecha: LocalDate): boolean
  }
  class Residencia {
    - tipo: TipoResidente
    - desde: LocalDate
    - hasta: LocalDate
    - autorizadaPorTitular: boolean
    + estaVigente(fecha: LocalDate): boolean
    + autorizar(): void
    + finalizar(fecha: LocalDate): void
  }
  enum TipoResidente {
    TITULAR
    FAMILIAR
    INQUILINO
  }
}

package "Personal" {
  abstract class Empleado {
    - legajo: String
    - nombre: String
    - fechaIngreso: LocalDate
    # Empleado(legajo: String, nombre: String, ingreso: LocalDate)
    + getLegajo(): String
    + {abstract} describirRol(): String
  }
  class Administrador {
    + describirRol(): String
  }
  class Guardia {
    - turno: String
    - puesto: PuestoGuardia
    + describirRol(): String
    + estaEnPorteria(): boolean
  }
  class EmpleadoMantenimiento {
    - especialidad: Especialidad
    + describirRol(): String
    + getEspecialidad(): Especialidad
  }
  enum PuestoGuardia {
    PORTERIA
    RONDA
    MONITOREO
  }
  enum Especialidad {
    ELECTRICIDAD
    PLOMERIA
    JARDINERIA
  }
}

package "Reclamos" {
  class Reclamo {
    - numero: int
    - fecha: LocalDateTime
    - tipo: TipoReclamo
    - descripcion: String
    - prioridad: PrioridadReclamo
    - estado: EstadoReclamo
    + asignar(responsable: Empleado, fecha: LocalDateTime): void
    + cambiarEstado(nuevo: EstadoReclamo, observacion: String, fecha: LocalDateTime): void
    + reabrir(motivo: String, fecha: LocalDateTime): void
    + agregarComentario(autor: String, texto: String, fecha: LocalDateTime): void
    + requiereEscalamiento(ahora: LocalDateTime): boolean
    + cerrarPorPlazo(ahora: LocalDateTime): void
    + compareTo(otro: Reclamo): int
  }
  class CambioEstado {
    - fecha: LocalDateTime
    - estadoNuevo: EstadoReclamo
    - observacion: String
  }
  class Comentario {
    - autor: String
    - fecha: LocalDateTime
    - texto: String
  }
  enum TipoReclamo {
    SEGURIDAD
    MANTENIMIENTO
    CONVIVENCIA
    ADMINISTRATIVO
  }
  enum PrioridadReclamo {
    ALTA
    MEDIA
    BAJA
  }
  enum EstadoReclamo {
    ABIERTO
    ASIGNADO
    EN_CURSO
    RESUELTO
    CERRADO
  }
}

package "Expensas y pagos" {
  class Expensa {
    - periodo: YearMonth
    - importe: BigDecimal
    - vencimiento: LocalDate
    - estado: EstadoExpensa
    + capitalPendiente(): BigDecimal
    + interesPendiente(fecha: LocalDate, mora: CalculadoraMora): BigDecimal
    + calcularSaldo(fecha: LocalDate, mora: CalculadoraMora): BigDecimal
    + aplicarImputacion(imputacion: Imputacion): void
  }
  class Pago {
    - numero: int
    - fecha: LocalDate
    - importe: BigDecimal
    - medio: MedioPago
    + saldoSinImputar(): BigDecimal
    + Pago(numero: int, lote: Lote, fecha: LocalDate, importe: BigDecimal, medio: MedioPago)
    + imputar(expensas: List<Expensa>, fecha: LocalDate, mora: CalculadoraMora): void
    + registrarAjuste(importe: BigDecimal, motivo: String, fecha: LocalDate): AjustePago
    + estaRevertido(): boolean
  }
  class Imputacion {
    - fecha: LocalDate
    - importeInteres: BigDecimal
    - importeCapital: BigDecimal
    + Imputacion(expensa: Expensa, fecha: LocalDate, interes: BigDecimal, capital: BigDecimal)
    + calcularTotal(): BigDecimal
    + crearReversion(fecha: LocalDate): Imputacion
  }
  class AjustePago {
    - numero: int
    - fecha: LocalDate
    - importe: BigDecimal
    - motivo: String
  }
  enum MedioPago {
    EFECTIVO
    TRANSFERENCIA
    TARJETA
  }
  enum EstadoExpensa {
    IMPAGA
    PARCIAL
    PAGADA
  }
}

package "Equipos y mantenimiento" {
  abstract class Equipo {
    - codigo: String
    - fechaInstalacion: LocalDate
    - estado: EstadoEquipo
    # Equipo(codigo: String, sector: Sector, instalacion: LocalDate)
    + registrarFalla(descripcion: String, fecha: LocalDateTime): FallaEquipo
    + cambiarEstado(nuevo: EstadoEquipo): void
    + {abstract} prioridadDeFalla(falladasEnSector: int): PrioridadOrden
  }
  class Camara {
    - resolucion: String
    - diasGrabacion: int
    + prioridadDeFalla(falladasEnSector: int): PrioridadOrden
    + requiereAviso(ahora: LocalDateTime): boolean
  }
  class Luminaria {
    - tipoLampara: String
    - potencia: double
    + prioridadDeFalla(falladasEnSector: int): PrioridadOrden
  }
  class Sector {
    - nombre: String
    + contarLuminariasFalladas(): int
  }
  class FallaEquipo {
    - fecha: LocalDateTime
    - descripcion: String
    - registradaPor: String
    + agregarObservacion(autor: String, texto: String, fecha: LocalDateTime): void
  }
  class OrdenMantenimiento {
    - numero: int
    - apertura: LocalDateTime
    - prioridad: PrioridadOrden
    - descripcionTrabajo: String
    - cierre: LocalDateTime
    - descripcionReparacion: String
    + iniciarReparacion(): void
    + cerrar(fecha: LocalDateTime, tecnico: EmpleadoMantenimiento, descripcion: String): void
    + elevarPrioridad(): void
    + agregarObservacion(texto: String): void
  }
  enum EstadoEquipo {
    OPERATIVO
    CON_FALLA
    EN_REPARACION
    FUERA_DE_SERVICIO
  }
  enum PrioridadOrden {
    ALTA
    NORMAL
  }
}

package "Visitas y avisos" {
  class Visitante {
    - nombre: String
    - documento: String
  }
  class Autorizacion {
    - desde: LocalDate
    - hasta: LocalDate
    - horaDesde: LocalTime
    - horaHasta: LocalTime
    - recurrente: boolean
    + validarDuracion(): void
    + estaVigente(fecha: LocalDateTime): boolean
  }
  class RegistroIngreso {
    - ingreso: LocalDateTime
    - egreso: LocalDateTime
    + RegistroIngreso(autorizacion: Autorizacion, guardia: Guardia, ingreso: LocalDateTime)
    + estaAbierto(): boolean
    + registrarEgreso(fecha: LocalDateTime): void
  }
  class Notificacion {
    - fecha: LocalDateTime
    - motivo: String
    - destinatario: String
    - referencia: String
    - leida: boolean
    - claveUnica: String
  }
}

Barrio "1" *-- "150" Lote
Barrio "1" o-- "1..*" Empleado : coordina
Barrio "1" *-- "1..*" Sector
Lote "1" *-- "1..*" Residencia
Persona "1" -- "0..*" Residencia
Empleado <|-- Administrador
Empleado <|-- Guardia
Empleado <|-- EmpleadoMantenimiento
Lote "1" -- "0..*" Reclamo
Persona "1" -- "0..*" Reclamo : solicitante
Empleado "0..1" -- "0..*" Reclamo : responsable
Reclamo "1" *-- "1..*" CambioEstado
Reclamo "1" *-- "0..*" Comentario
Lote "1" *-- "0..*" Expensa
Lote "1" -- "0..*" Pago
Pago "1" *-- "0..*" Imputacion
Expensa "1" -- "0..*" Imputacion
Pago "1" *-- "0..*" AjustePago
Equipo <|-- Camara
Equipo <|-- Luminaria
Sector "1" -- "0..*" Equipo
Equipo "1" *-- "0..*" FallaEquipo
Equipo "1" -- "0..*" OrdenMantenimiento
FallaEquipo "1" -- "0..1" OrdenMantenimiento
EmpleadoMantenimiento "0..1" -- "0..*" OrdenMantenimiento : tecnico
Persona "1" -- "0..*" Autorizacion : otorgante
Lote "1" -- "0..*" Autorizacion
Visitante "1" -- "0..*" Autorizacion
Autorizacion "1" -- "0..*" RegistroIngreso
Guardia "1" -- "0..*" RegistroIngreso : habilita
Barrio "1" *-- "0..*" Notificacion

note right of Residencia
  Un unico TITULAR vigente por lote.
  FAMILIAR e INQUILINO requieren autorizacion
  explicita del titular para presentar reclamos.
  hasta puede ser null si sigue vigente.
end note
note right of Reclamo
  Responsable opcional solo en ABIERTO.
  Maximo 5 EN_CURSO por empleado.
  Reapertura: RESUELTO -> EN_CURSO
  dentro de los 5 dias, respetando el limite.
  Comparable: prioridad y luego fecha.
end note
note right of Equipo
  Camara: prioridad ALTA.
  Luminaria: NORMAL; ALTA con mas de 3
  luminarias falladas en el mismo sector.
end note

note bottom of RegistroIngreso
  egreso null indica visita dentro del barrio.
  No se permite otro ingreso abierto
  del mismo documento, aun para otro lote.
end note

package "Coordinacion de casos de uso" {
  class ConsolaSIGMA {
    + ejecutarMenu(): void
  }
  class GestorReclamos {
    + registrarReclamo(lote: Lote, solicitante: Persona, tipo: TipoReclamo, descripcion: String, fecha: LocalDateTime): Reclamo
    + asignarReclamo(reclamo: Reclamo, empleado: Empleado, fecha: LocalDateTime): void
    + cambiarEstado(reclamo: Reclamo, empleado: Empleado, nuevo: EstadoReclamo, observacion: String, fecha: LocalDateTime): void
    + reabrir(reclamo: Reclamo, vecino: Persona, motivo: String, fecha: LocalDateTime): void
    + agregarComentario(reclamo: Reclamo, autor: String, texto: String, fecha: LocalDateTime): void
    + consultarSeguimiento(reclamo: Reclamo, vecino: Persona): Reclamo
    + consultarPendientes(ahora: LocalDateTime): List<Reclamo>
    + verificarPlazos(ahora: LocalDateTime): void
  }
  class GestorExpensas {
    - expensas: RepositorioExpensas
    - pagos: RepositorioPagos
    - mora: CalculadoraMora
    + GestorExpensas(expensas: RepositorioExpensas, pagos: RepositorioPagos, mora: CalculadoraMora)
    + emitirExpensas(barrio: Barrio, periodo: YearMonth, presupuesto: BigDecimal): void
    + registrarPago(lote: Lote, importe: BigDecimal, medio: MedioPago, fecha: LocalDate): Pago
    + registrarAjuste(pago: Pago, importe: BigDecimal, motivo: String, fecha: LocalDate): AjustePago
    + consultarCuenta(lote: Lote, fecha: LocalDate): BigDecimal
    + aplicarSaldosAFavor(lote: Lote, fecha: LocalDate): void
    + verificarMorosidad(fecha: LocalDate): void
  }
  class GestorAccesos {
    - autorizaciones: RepositorioAutorizaciones
    - ingresos: RepositorioIngresos
    + GestorAccesos(autorizaciones: RepositorioAutorizaciones, ingresos: RepositorioIngresos)
    + autorizarVisita(otorgante: Persona, lote: Lote, visitante: Visitante, desde: LocalDate, hasta: LocalDate, horaDesde: LocalTime, horaHasta: LocalTime, recurrente: boolean): Autorizacion
    + registrarIngreso(documento: String, lote: Lote, guardia: Guardia, fecha: LocalDateTime): RegistroIngreso
    + registrarEgreso(documento: String, fecha: LocalDateTime): void
  }
  class GestorMantenimiento {
    + registrarFalla(equipo: Equipo, autor: String, descripcion: String, fecha: LocalDateTime): FallaEquipo
    + generarOrden(administrador: Administrador, falla: FallaEquipo, tecnico: EmpleadoMantenimiento, fecha: LocalDateTime): OrdenMantenimiento
    + cerrarOrden(orden: OrdenMantenimiento, tecnico: EmpleadoMantenimiento, descripcion: String, fecha: LocalDateTime): void
    + consultarEquipos(ahora: LocalDateTime): List<Equipo>
    + verificarPlazos(ahora: LocalDateTime): void
  }
  class GestorReportes {
    + reclamosPendientes(ahora: LocalDateTime): String
    + morosidad(fecha: LocalDate): String
    + equiposFueraDeServicio(ahora: LocalDateTime): String
    + exportar(texto: String, ruta: String): void
  }
  class CalculadoraMora {
    - tasaMensual: BigDecimal
    + calcular(expensa: Expensa, fecha: LocalDate): BigDecimal
  }
}
package "Contratos de persistencia" {
  interface RepositorioExpensas {
    + buscarPorLote(lote: Lote): List<Expensa>
    + existePeriodo(periodo: YearMonth): boolean
    + guardar(expensa: Expensa): void
  }
  interface RepositorioPagos {
    + siguienteNumero(): int
    + guardar(pago: Pago): void
    + confirmarPago(pago: Pago, expensas: List<Expensa>, lote: Lote): void
    + buscarPorLote(lote: Lote): List<Pago>
    + confirmarAjuste(pago: Pago, ajuste: AjustePago, expensas: List<Expensa>, lote: Lote): void
  }
  interface RepositorioAutorizaciones {
    + buscar(documento: String, lote: Lote): List<Autorizacion>
    + guardar(autorizacion: Autorizacion): void
  }
  interface RepositorioIngresos {
    + buscarAbierto(documento: String): RegistroIngreso
    + guardar(registro: RegistroIngreso): void
  }
  interface RepositorioReclamos {
    + listar(): List<Reclamo>
    + contarEnCurso(empleado: Empleado): int
    + guardar(reclamo: Reclamo): void
  }
  interface RepositorioEquipos {
    + listar(): List<Equipo>
    + guardar(equipo: Equipo): void
    + guardarOrden(orden: OrdenMantenimiento): void
  }
}
package "Persistencia en archivos" {
  class RepositorioExpensasArchivo
  class RepositorioPagosArchivo
  class RepositorioAutorizacionesArchivo
  class RepositorioIngresosArchivo
  class RepositorioReclamosArchivo
  class RepositorioEquiposArchivo
}
package "Pruebas" {
  class RepositorioExpensasMemoria
  class RepositorioPagosMemoria
}
package "Errores de negocio" {
  class ReglaNegocioException <<exception>>
  class AutorizacionInvalidaException <<exception>>
  class IngresoDuplicadoException <<exception>>
  class PagoInvalidoException <<exception>>
  class LimiteReclamosException <<exception>>
  class TransicionInvalidaException <<exception>>
}

ConsolaSIGMA --> GestorReclamos
ConsolaSIGMA --> GestorExpensas
ConsolaSIGMA --> GestorAccesos
ConsolaSIGMA --> GestorMantenimiento
ConsolaSIGMA --> GestorReportes
GestorReclamos --> RepositorioReclamos
GestorReclamos ..> Reclamo
GestorExpensas --> RepositorioExpensas
GestorExpensas --> RepositorioPagos
GestorExpensas --> CalculadoraMora
GestorExpensas ..> Pago
GestorAccesos --> RepositorioAutorizaciones
GestorAccesos --> RepositorioIngresos
GestorAccesos ..> RegistroIngreso
GestorMantenimiento --> RepositorioEquipos
GestorMantenimiento ..> Equipo
GestorReportes --> RepositorioReclamos
GestorReportes --> RepositorioExpensas
GestorReportes --> RepositorioEquipos
GestorReportes --> CalculadoraMora
Expensa ..> CalculadoraMora
Pago ..> CalculadoraMora
RepositorioExpensas <|.. RepositorioExpensasArchivo
RepositorioPagos <|.. RepositorioPagosArchivo
RepositorioAutorizaciones <|.. RepositorioAutorizacionesArchivo
RepositorioIngresos <|.. RepositorioIngresosArchivo
RepositorioReclamos <|.. RepositorioReclamosArchivo
RepositorioEquipos <|.. RepositorioEquiposArchivo
RepositorioExpensas <|.. RepositorioExpensasMemoria
RepositorioPagos <|.. RepositorioPagosMemoria
ReglaNegocioException <|-- AutorizacionInvalidaException
ReglaNegocioException <|-- IngresoDuplicadoException
ReglaNegocioException <|-- PagoInvalidoException
ReglaNegocioException <|-- LimiteReclamosException
ReglaNegocioException <|-- TransicionInvalidaException
ReglaNegocioException --|> Exception


package "Evaluacion de plazos" {
  class PlanificadorPlazos {
    + ejecutar(ahora: LocalDateTime): void
  }
  interface RepositorioNotificaciones {
    + guardarSiNoExiste(notificacion: Notificacion): boolean
  }
  class RepositorioNotificacionesArchivo
}
ConsolaSIGMA --> PlanificadorPlazos
PlanificadorPlazos --> GestorReclamos
PlanificadorPlazos --> GestorMantenimiento
PlanificadorPlazos --> GestorExpensas
GestorReclamos --> RepositorioNotificaciones
GestorMantenimiento --> RepositorioNotificaciones
GestorExpensas --> RepositorioNotificaciones
RepositorioNotificaciones <|.. RepositorioNotificacionesArchivo
AjustePago "0..1" -- "0..*" Imputacion : identifica contraimputaciones
note right of OrdenMantenimiento
  Puede esperar tecnico mientras no inicio.
  Al cerrar debe registrar fecha, tecnico y reparacion.
end note
@enduml
