@startuml 06-arquitectura
title SIGMA - Modelo final   arquitectura
scale max 3800*3800
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam classAttributeIconSize 0
skinparam shadowing false
hide empty members
hide members

class ConsolaSIGMA {
    + ejecutarMenu(): void
    + ConsolaSIGMA(aplicacion: AplicacionSIGMA)
  }

class GestorReclamos {
    - reclamos: RepositorioReclamos
    - notificaciones: RepositorioNotificaciones
    + registrarReclamo(lote: Lote, solicitante: Persona, tipo: TipoReclamo, descripcion: String, fecha: LocalDateTime): Reclamo
    + asignarReclamo(reclamo: Reclamo, empleado: Empleado, fecha: LocalDateTime): void
    + cambiarEstado(reclamo: Reclamo, empleado: Empleado, nuevo: EstadoReclamo, observacion: String, fecha: LocalDateTime): void
    + reabrir(reclamo: Reclamo, vecino: Persona, motivo: String, fecha: LocalDateTime): void
    + agregarComentario(reclamo: Reclamo, autor: String, texto: String, fecha: LocalDateTime): void
    + consultarSeguimiento(reclamo: Reclamo, vecino: Persona): Reclamo
    + consultarPendientes(ahora: LocalDateTime): List<Reclamo>
    + verificarPlazos(ahora: LocalDateTime): void
    + GestorReclamos(reclamos: RepositorioReclamos, notificaciones: RepositorioNotificaciones)
    + buscarReclamo(numero: int): Reclamo
  }

class GestorExpensas {
    - expensas: RepositorioExpensas
    - pagos: RepositorioPagos
    - mora: CalculadoraMora
    - notificaciones: RepositorioNotificaciones
    + GestorExpensas(expensas: RepositorioExpensas, pagos: RepositorioPagos, mora: CalculadoraMora, notificaciones: RepositorioNotificaciones)
    + emitirExpensas(barrio: Barrio, periodo: YearMonth, presupuesto: BigDecimal): void
    + registrarPago(lote: Lote, importe: BigDecimal, medio: MedioPago, fecha: LocalDate): Pago
    + registrarAjuste(pago: Pago, importe: BigDecimal, motivo: String, fecha: LocalDate): AjustePago
    + consultarCuenta(lote: Lote, fecha: LocalDate): BigDecimal
    + aplicarSaldosAFavor(lote: Lote, fecha: LocalDate): void
    + verificarMorosidad(fecha: LocalDate): void
    + saldoAFavor(lote: Lote): BigDecimal
    + consultarPagos(lote: Lote): List<Pago>
    + consultarExpensas(lote: Lote): List<Expensa>
  }

class GestorAccesos {
    - autorizaciones: RepositorioAutorizaciones
    - ingresos: RepositorioIngresos
    + GestorAccesos(autorizaciones: RepositorioAutorizaciones, ingresos: RepositorioIngresos)
    + autorizarVisita(otorgante: Persona, lote: Lote, visitante: Visitante, desde: LocalDate, hasta: LocalDate, horaDesde: LocalTime, horaHasta: LocalTime, recurrente: boolean): Autorizacion
    + registrarIngreso(documento: String, lote: Lote, guardia: Guardia, fecha: LocalDateTime): RegistroIngreso
    + registrarEgreso(documento: String, fecha: LocalDateTime): void
  }

class GestorMantenimiento {
    - equipos: RepositorioEquipos
    - notificaciones: RepositorioNotificaciones
    + registrarFalla(equipo: Equipo, autor: String, descripcion: String, fecha: LocalDateTime): FallaEquipo
    + generarOrden(administrador: Administrador, falla: FallaEquipo, tecnico: EmpleadoMantenimiento, fecha: LocalDateTime): OrdenMantenimiento
    + cerrarOrden(orden: OrdenMantenimiento, tecnico: EmpleadoMantenimiento, descripcion: String, fecha: LocalDateTime): void
    + consultarEquipos(ahora: LocalDateTime): List<Equipo>
    + verificarPlazos(ahora: LocalDateTime): void
    + GestorMantenimiento(equipos: RepositorioEquipos, notificaciones: RepositorioNotificaciones)
    + registrarEquipo(equipo: Equipo): void
    + asignarTecnico(orden: OrdenMantenimiento, tecnico: EmpleadoMantenimiento): void
    + iniciarReparacion(orden: OrdenMantenimiento): void
    + cerrarOrdenSinReparacion(orden: OrdenMantenimiento, tecnico: EmpleadoMantenimiento, descripcion: String, fecha: LocalDateTime): void
    + consultarOrdenes(): List<OrdenMantenimiento>
    + consultarOrdenesAbiertas(equipo: Equipo): List<OrdenMantenimiento>
    + buscarEquipo(codigo: String): Equipo
    + buscarOrden(numero: int): OrdenMantenimiento
  }

class GestorReportes {
    + reclamosPendientes(ahora: LocalDateTime): String
    + morosidad(fecha: LocalDate): String
    + equiposFueraDeServicio(ahora: LocalDateTime): String
    + exportar(texto: String, ruta: String): void
    + GestorReportes(reclamos: RepositorioReclamos, expensas: RepositorioExpensas, equipos: RepositorioEquipos, mora: CalculadoraMora)
  }

class PlanificadorPlazos {
    + ejecutar(ahora: LocalDateTime): void
    + PlanificadorPlazos(reclamos: GestorReclamos, mantenimiento: GestorMantenimiento, expensas: GestorExpensas)
  }

class CalculadoraMora {
    - tasaMensual: BigDecimal
    + calcular(expensa: Expensa, fecha: LocalDate): BigDecimal
    + CalculadoraMora(tasaMensual: BigDecimal)
    ~ interesPorDias(capital: BigDecimal, dias: long): BigDecimal
  }

interface RepositorioExpensas {
    + buscarPorLote(lote: Lote): List<Expensa>
    + existePeriodo(periodo: YearMonth): boolean
    + guardar(expensa: Expensa): void
    + listarLotes(): List<Lote>
  }

interface RepositorioPagos {
    + siguienteNumero(): int
    + guardar(pago: Pago): void
    + confirmarPago(pago: Pago, expensas: List<Expensa>, lote: Lote): void
    + buscarPorLote(lote: Lote): List<Pago>
    + confirmarAjuste(pago: Pago, ajuste: AjustePago, expensas: List<Expensa>, lote: Lote): void
  }

interface RepositorioAutorizaciones {
    + buscar(documento: String, lote: Lote): List<Autorizacion>
    + guardar(autorizacion: Autorizacion): void
  }

interface RepositorioIngresos {
    + buscarAbierto(documento: String): RegistroIngreso
    + guardar(registro: RegistroIngreso): void
  }

interface RepositorioReclamos {
    + listar(): List<Reclamo>
    + contarEnCurso(empleado: Empleado): int
    + guardar(reclamo: Reclamo): void
  }

interface RepositorioEquipos {
    + listar(): List<Equipo>
    + guardar(equipo: Equipo): void
    + guardarOrden(orden: OrdenMantenimiento): void
    + listarOrdenes(): List<OrdenMantenimiento>
  }

class RepositorioExpensasArchivo

class RepositorioPagosArchivo

class RepositorioAutorizacionesArchivo

class RepositorioIngresosArchivo

class RepositorioReclamosArchivo

class RepositorioEquiposArchivo

class RepositorioExpensasMemoria

class RepositorioPagosMemoria

interface RepositorioNotificaciones {
    + guardarSiNoExiste(notificacion: Notificacion): boolean
    + listar(): List<Notificacion>
  }

class RepositorioNotificacionesArchivo

class RepositorioReclamosMemoria

class RepositorioEquiposMemoria

class RepositorioAutorizacionesMemoria

class RepositorioIngresosMemoria

class RepositorioNotificacionesMemoria

class VentanaSIGMA

interface Interaccion

class OperacionesSIGMA

class AplicacionSIGMA

class Main

class AlmacenArchivos

class DatosSIGMA
GestorReclamos --> RepositorioReclamos
GestorExpensas --> RepositorioExpensas
GestorExpensas --> RepositorioPagos
GestorExpensas --> CalculadoraMora
GestorAccesos --> RepositorioAutorizaciones
GestorAccesos --> RepositorioIngresos
GestorMantenimiento --> RepositorioEquipos
GestorReportes --> RepositorioReclamos
GestorReportes --> RepositorioExpensas
GestorReportes --> RepositorioEquipos
GestorReportes --> CalculadoraMora
RepositorioExpensas <|.. RepositorioExpensasArchivo
RepositorioPagos <|.. RepositorioPagosArchivo
RepositorioAutorizaciones <|.. RepositorioAutorizacionesArchivo
RepositorioIngresos <|.. RepositorioIngresosArchivo
RepositorioReclamos <|.. RepositorioReclamosArchivo
RepositorioEquipos <|.. RepositorioEquiposArchivo
RepositorioExpensas <|.. RepositorioExpensasMemoria
RepositorioPagos <|.. RepositorioPagosMemoria
PlanificadorPlazos --> GestorReclamos
PlanificadorPlazos --> GestorMantenimiento
PlanificadorPlazos --> GestorExpensas
GestorReclamos --> RepositorioNotificaciones
GestorMantenimiento --> RepositorioNotificaciones
GestorExpensas --> RepositorioNotificaciones
RepositorioNotificaciones <|.. RepositorioNotificacionesArchivo
Interaccion <|.. ConsolaSIGMA
Interaccion <|.. VentanaSIGMA
ConsolaSIGMA --> OperacionesSIGMA
VentanaSIGMA --> OperacionesSIGMA
OperacionesSIGMA --> Interaccion
OperacionesSIGMA --> AplicacionSIGMA
Main ..> AplicacionSIGMA
Main ..> ConsolaSIGMA
Main ..> VentanaSIGMA
AplicacionSIGMA --> GestorReclamos
AplicacionSIGMA --> GestorExpensas
AplicacionSIGMA --> GestorAccesos
AplicacionSIGMA --> GestorMantenimiento
AplicacionSIGMA --> GestorReportes
AplicacionSIGMA --> PlanificadorPlazos
AplicacionSIGMA --> AlmacenArchivos
AlmacenArchivos --> DatosSIGMA
RepositorioExpensasArchivo --> AlmacenArchivos
RepositorioPagosArchivo --> AlmacenArchivos
RepositorioAutorizacionesArchivo --> AlmacenArchivos
RepositorioIngresosArchivo --> AlmacenArchivos
RepositorioReclamosArchivo --> AlmacenArchivos
RepositorioEquiposArchivo --> AlmacenArchivos
RepositorioNotificacionesArchivo --> AlmacenArchivos
RepositorioReclamos <|.. RepositorioReclamosMemoria
RepositorioEquipos <|.. RepositorioEquiposMemoria
RepositorioAutorizaciones <|.. RepositorioAutorizacionesMemoria
RepositorioIngresos <|.. RepositorioIngresosMemoria
RepositorioNotificaciones <|.. RepositorioNotificacionesMemoria
@enduml